{
  "name": "layrcake",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Layrcake API. Go-to-market infrastructure for AI agents.",
  "keywords": [
    "layrcake",
    "ai",
    "agents",
    "mcp",
    "sales",
    "prospecting",
    "lead-generation",
    "email-verification",
    "claude",
    "chatgpt"
  ],
  "homepage": "https://layrcake.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layrcake-dev/layrcake-js.git"
  },
  "bugs": {
    "url": "https://github.com/Layrcake-dev/layrcake-js/issues"
  },
  "license": "MIT",
  "author": "Layrcake",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check-generated": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "vite": "^6.4.1"
  }
}
